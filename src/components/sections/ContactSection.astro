---
import { siteConfig, mailto, whatsapp, withBase } from "../../lib/site";
import Icon from "../ui/Icon.astro";

const whatsappHref = whatsapp(
  "Hola Dreamcoder, vi tu portafolio y me gustaría conversar sobre un proyecto.",
);
---

<section
  id="connect"
  class="contact-section wrap"
  aria-labelledby="contact-title"
  data-reveal
>
  <p class="eyebrow scene-kicker">Contacto</p>
  <h2 id="contact-title" class="scene-heading">
    ¿Algo interesante
    <br />
    por <span>construir?</span>
  </h2>
  <div class="contact-bottom">
    <p>
      Cuéntame la idea o el problema. Te respondo con los siguientes pasos y un
      alcance claro.
    </p>
    <div class="contact-actions">
      <a
        class="solid-link contact-whatsapp"
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        data-contact="whatsapp"
      >
        <Icon name="whatsapp" size={20} /> Escríbeme por WhatsApp
      </a>
      <a
        class="solid-link contact-email"
        href={mailto("Contacto desde el portafolio")}
        data-contact="email"
      >
        <Icon name="mail" size={20} /> Enviar un correo
      </a>
    </div>
  </div>
  <ul class="contact-channels" aria-label="Otros datos de contacto">
    <li>
      <a href={withBase("/dreamcoder.vcf")} download="dreamcoder.vcf">
        Guardar contacto
      </a>
    </li>
    <li>
      <a href={siteConfig.social.github} rel="me">
        <Icon name="github" size={17} /> GitHub
      </a>
    </li>
    <li>
      <a href={siteConfig.social.x} rel="me">
        <Icon name="x" size={16} /> X
      </a>
    </li>
    <li>
      <a href={siteConfig.social.instagram} rel="me">
        <Icon name="instagram" size={16} /> Instagram
      </a>
    </li>
  </ul>
</section>
