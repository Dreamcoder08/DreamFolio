---
import { whatsapp } from "../../lib/site";
import Icon from "../ui/Icon.astro";
import ProfileCard from "../ui/ProfileCard.astro";
import ConvergenceField from "../ui/ConvergenceField.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <ConvergenceField />
  <div class="hero-content wrap">
    <div class="hero-stage">
      <div class="hero-copy">
        <p class="hero-intro">Software, sistemas de IA y producto digital</p>
        <h1 id="hero-title">
          Ideas que
          <br />
          <span>se vuelven</span>
          <br />
          sistemas.
        </h1>
        <div class="hero-brief">
          <p>
            Diseño y construyo software con criterio técnico, interfaces claras
            y decisiones que se pueden explicar.
          </p>
          <div class="actions">
            <a
              class="solid-link"
              href={whatsapp(
                "Hola Dreamcoder, vi tu portafolio y me gustaría conversar.",
              )}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="whatsapp" size={19} /> Escríbeme por WhatsApp
            </a>
            <a class="quiet-link" href="#projects">
              Ver proyectos <Icon name="down" size={17} />
            </a>
          </div>
        </div>
      </div>
      <div class="hero-portrait">
        <ProfileCard />
      </div>
    </div>
  </div>
</section>
