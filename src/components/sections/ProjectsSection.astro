---
// Unified projects & repos carousel with filter chips, arrows, and swipe.
import { getCollection } from "astro:content";
import { withBase } from "../../lib/site";
import {
  carouselOrder,
  domainLabel,
  getProjectSlug,
  SHARED_ART_PROJECT_IDS,
} from "../../lib/project-presentation";
import { projectCover } from "../../lib/project-cover";
import { buildHomeProjects } from "../../lib/home-projects";
import type { GitHubRepo } from "../../lib/github-repos";
import Icon from "../ui/Icon.astro";
import source from "../../data/projects.json";
import repoSnapshot from "../../data/github-repos.json";
import archifyMap from "../../data/repo-archify.json";

// getCollection() does not promise the file's order, so it is restored
// from projects.json before the carousel ordering applies.
const fileOrder = source.map((entry) => entry.id);
const curated = carouselOrder(
  (await getCollection("projects"))
    .map(({ data }) => data)
    .sort((a, b) => fileOrder.indexOf(a.id) - fileOrder.indexOf(b.id)),
  (project) => Boolean(projectCover(project)),
);
const projects = buildHomeProjects({
  curated,
  repos: repoSnapshot.repos as GitHubRepo[],
  archifyMap,
  resolveCover: (project) => projectCover(project) ?? undefined,
  getSlug: getProjectSlug,
  domainLabel,
});
const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(projects.length);
const filterChips = [
  { key: "all", label: `Todos (${projects.length})` },
  { key: "case-study", label: `Casos de estudio (${curated.length})` },
  { key: "arkelythex", label: "ARKELYTHEX" },
  { key: "personal", label: "Personal" },
];
---

<section
  id="projects"
  class="work-section wrap"
  aria-labelledby="work-title"
  data-reveal
>
  <header class="section-heading">
    <div>
      <p class="eyebrow scene-kicker">Proyectos</p>
      <h2 id="work-title" class="scene-heading">
        Lo que he construido.
        <br />
        <span>Una práctica en evolución.</span>
      </h2>
    </div>
    <a class="quiet-link" href={withBase("/projects/")}>
      Todos los proyectos y repos <Icon name="arrow" size={18} />
    </a>
  </header>

  <div
    class="project-carousel"
    role="region"
    aria-roledescription="carousel"
    aria-label="Proyectos y repositorios"
    data-carousel
  >
    <div class="carousel-toolbar">
      <div class="carousel-filters" role="group" aria-label="Filtrar proyectos">
        {filterChips.map((chip, i) => (
          <button
            type="button"
            class="filter-chip"
            data-carousel-filter={chip.key}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {chip.label}
          </button>
        ))}
      </div>
      <div class="carousel-controls" data-carousel-controls hidden>
        <button
          type="button"
          class="circle-link"
          data-carousel-prev
          aria-label="Proyecto anterior"
          aria-controls="project-track"
        >
          <Icon name="back" size={20} />
        </button>
        <p class="carousel-count mono" aria-live="polite">
          <span data-carousel-index>01</span> /{" "}
          <span data-carousel-total>{total}</span>
        </p>
        <button
          type="button"
          class="circle-link"
          data-carousel-next
          aria-label="Proyecto siguiente"
          aria-controls="project-track"
        >
          <Icon name="next" size={20} />
        </button>
      </div>
    </div>
    <ul
      id="project-track"
      class="project-track"
      role="list"
      tabindex="0"
      aria-label="Proyectos, desliza o usa las flechas"
      data-carousel-track
    >
      {projects.map((project, index) => {
        const href = project.isExternal ? project.href : withBase(project.href);
        const linkAttrs = project.isExternal
          ? { target: "_blank", rel: "noopener noreferrer" }
          : {};
        const cover = project.cover;
        return (
          <li class="project-card" data-filters={project.filters.join(" ")}>
            <a
              class="project-cover"
              href={href}
              tabindex="-1"
              aria-hidden="true"
              {...linkAttrs}
            >
              {cover ? (
                <img
                  class:list={[
                    project.sharedArtId &&
                      SHARED_ART_PROJECT_IDS.has(project.sharedArtId) &&
                      `vt-art-${project.sharedArtId}`,
                  ]}
                  src={withBase(cover.src)}
                  alt=""
                  width={cover.width}
                  height={cover.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="project-cover-mark">{project.title}</span>
              )}
            </a>
            <div class="project-body">
              <div class="compact-heading">
                <p class="eyebrow">{project.eyebrow}</p>
                <span class="project-number">{pad(index + 1)}</span>
              </div>
              <h3>
                <a href={href} {...linkAttrs}>
                  {project.title}
                </a>
              </h3>
              <p>{project.summary}</p>
              <div class="tags">
                {project.stack.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <div class="project-links">
                <a href={href} {...linkAttrs}>
                  {project.ctaLabel} <Icon name="arrow" size={17} />
                </a>
                {project.archifyHref && (
                  <a
                    href={withBase(project.archifyHref)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Arquitectura
                  </a>
                )}
                {!project.isExternal && project.githubUrl && (
                  <a href={project.githubUrl}>
                    <Icon name="github" size={18} /> GitHub
                  </a>
                )}
                {project.liveUrl && <a href={project.liveUrl}>Demo</a>}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  import { mountProjectCarousels } from "../../lib/project-carousel-client";
  mountProjectCarousels();
</script>
