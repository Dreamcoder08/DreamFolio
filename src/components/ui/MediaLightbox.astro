---

<dialog
  class="media-lightbox"
  data-media-lightbox
  aria-label="Vista ampliada de la imagen"
>
  <div class="media-lightbox-body">
    <button
      type="button"
      class="media-lightbox-close mono"
      data-lightbox-close
      aria-label="Cerrar vista ampliada"
    >
      Cerrar · Esc
    </button>
    <img alt="" data-lightbox-image />
    <p class="media-lightbox-caption" data-lightbox-caption></p>
  </div>
</dialog>
