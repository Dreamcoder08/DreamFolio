---
import Icon from "./Icon.astro";
import { withBaseAsset } from "../../lib/site";
---

<aside class="profile-card" aria-label="Perfil de Dreamcoder">
  <figure class="profile-portrait">
    <img
      src={withBaseAsset("/images/dreamcoder-profile.avif")}
      srcset={`${withBaseAsset("/images/dreamcoder-profile.avif")} 420w, ${withBaseAsset("/images/dreamcoder-profile-hq.avif")} 720w`}
      sizes="(max-width: 720px) 88vw, (max-width: 1024px) 320px, 390px"
      alt="Dreamcoder con chaqueta técnica y gafas frente a un paisaje alpino"
      width="280"
      height="350"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </figure>
  <div class="profile-bio">
    <p class="profile-name">Dreamcoder</p>
    <p class="profile-role">Software & sistemas de IA</p>
    <div class="profile-location">
      <Icon name="location" size={15} />
      <span>Perú · UTC−5</span>
    </div>
  </div>
</aside>
