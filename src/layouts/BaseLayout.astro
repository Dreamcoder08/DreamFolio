---
import "../styles/global.css";
import { siteConfig, toAbsoluteSiteUrl, withBaseAsset } from "../lib/site";
import { resolveAnalytics } from "../lib/analytics.ts";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Arquitectura de software y sistemas de IA con supervisión humana y evidencia verificable.",
  image = "/images/projects/fiscal-workspace.jpg",
  jsonLd,
  lang = "es",
} = Astro.props;

const siteOrigin = Astro.site?.toString() ?? "https://dreamcoder08.github.io";

// The same resolution astro.config.mjs uses to build the CSP, so the
// script tag and the policy that allows it can never disagree. See
// src/lib/analytics.ts.
const analytics = resolveAnalytics(import.meta.env);

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? siteOrigin,
).toString();

const imageUrl = /^https?:\/\//.test(image)
  ? image
  : toAbsoluteSiteUrl(image, siteOrigin);

const imageType = imageUrl.endsWith(".png")
  ? "image/png"
  : imageUrl.endsWith(".webp")
    ? "image/webp"
    : "image/jpeg";

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Dreamcoder",
  url: canonical,
  jobTitle: "Systems Architect",
  knowsAbout: [
    "Arquitectura de sistemas",
    "Sistemas de IA con supervisión humana",
    "Producto digital",
    "Trazabilidad y evidencia",
  ],
  sameAs: ["https://github.com/dreamcoder08"],
};

const structuredData = jsonLd ?? defaultJsonLd;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBaseAsset("/favicon.svg")}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:alt" content={`${title} preview image`} />
    <meta property="og:site_name" content="DreamFolio" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content={siteConfig.social.twitterHandle} />
    <meta
      property="twitter:creator"
      content={siteConfig.social.twitterHandle}
    />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={`${title} preview image`} />
    <meta name="theme-color" content="#000000" />

    <!-- Applies the stored theme before paint. It is an external blocking
         script rather than an inline one because Astro does not hash
         `is:inline` scripts, so an inline version would be silently blocked
         by the CSP. See public/theme-init.js. -->
    <script is:inline src={withBaseAsset("/theme-init.js")}></script>
    <!-- Fonts: self-hosted variable fonts. No third-party origin is contacted. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBaseAsset("/fonts/inter-var-v20.woff2")}
      crossorigin
    />
    <link rel="stylesheet" href={withBaseAsset("/fonts/fonts.css")} />

    <!-- Security headers are configured in vercel.json. -->

    <!-- SEO -->
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Dreamcoder08" />
    <meta
      name="keywords"
      content="arquitectura de software, sistemas de IA, automatización con supervisión, producto digital, seguridad de la información, Perú, LATAM"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
    <!-- Analytics: optional and single-sourced (src/lib/analytics.ts). -->
    {analytics.enabled && (
      <script
        defer
        src={analytics.src}
        data-website-id={analytics.websiteId}
      ></script>
    )}
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main-content" class="skip-link">
      {lang === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <slot />
    <!-- Bundled by Astro, so it is an external same-origin module that
         `script-src 'self'` already allows and that needs no hash. -->
    <script>
      (function () {
        try {
          var reduceMotion =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (reduceMotion || !("IntersectionObserver" in window)) return;
          var targets = document.querySelectorAll("[data-reveal]");
          if (!targets.length) return;
          var pending = new Set(targets);
          function reveal(el) {
            el.classList.add("is-visible");
            pending.delete(el);
            io.unobserve(el);
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) reveal(entry.target);
              });
            },
            { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
          );
          targets.forEach(function (el) {
            io.observe(el);
          });
          document.documentElement.classList.add("motion-ready");

          // A scroll jump large enough to carry a target from fully below
          // to fully above the viewport in one frame never registers as
          // intersecting, so it stays observed but never revealed. Sweep
          // on scroll and reveal anything already reached or passed.
          var sweepQueued = false;
          function sweep() {
            sweepQueued = false;
            pending.forEach(function (el) {
              if (el.getBoundingClientRect().top < window.innerHeight)
                reveal(el);
            });
            if (!pending.size) window.removeEventListener("scroll", queueSweep);
          }
          function queueSweep() {
            if (!sweepQueued) {
              sweepQueued = true;
              requestAnimationFrame(sweep);
            }
          }
          window.addEventListener("scroll", queueSweep, { passive: true });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
