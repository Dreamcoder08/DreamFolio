---
import Icon from "../components/ui/Icon.astro";
import { withBase } from "../lib/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/ui/Navbar.astro";
---

<BaseLayout
  title="404 — Página no encontrada"
  description="Esta página no existe."
  lang="es"
>
  <Navbar />
  <main
    id="main-content"
    class="min-h-screen flex items-center justify-center px-6"
  >
    <div class="text-center">
      <p class="text-accent font-mono text-8xl font-bold mb-4">404</p>
      <h1 class="text-2xl font-bold mb-4">Página no encontrada</h1>
      <p class="text-text-secondary mb-8">
        Puedes volver al portafolio para seguir explorando.
      </p>
      <a href={withBase("/")} class="btn-primary inline-flex">
        <Icon name="back" size={18} />
        Volver al inicio
      </a>
    </div>
  </main>
</BaseLayout>
