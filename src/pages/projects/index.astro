---
import Icon from "../../components/ui/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/ui/Navbar.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/site";
import { getProjectSlug } from "../../lib/project-presentation";
import RepoGrid from "../../components/ui/RepoGrid.astro";
import "../../styles/portfolio.css";
const projects = await getCollection("projects");
const caseStudies = new Map(
  projects
    .filter(({ data }) => data.githubUrl)
    .map(({ data }) => [
      data.githubUrl!.toLowerCase(),
      "/projects/" + getProjectSlug(data.title) + "/",
    ]),
);
---

<BaseLayout
  title="Proyectos — Dreamcoder"
  description="Proyectos y exploraciones técnicas en software, IA y herramientas para desarrolladores."
  lang="es"
>
  <Navbar />
  <main id="main-content" class="portfolio wrap projects-index">
    <a class="quiet-link" href={withBase("/#projects")}>
      <Icon name="back" size={17} />
      Volver al portafolio
    </a>
    <p class="eyebrow projects-eyebrow">Proyectos</p>
    <h1 class="projects-title">Código para explorar.</h1>
    <p class="projects-intro">
      Primero los casos con contexto; debajo,{" "}
      <a href="#github">todos mis repositorios públicos</a> y los de ARKELYTHEX.
    </p>
    <div class="project-pair">
      {projects.map(({ data: p }) => (
        <article class="small-project projects-entry">
          <p class="eyebrow">{p.domain}</p>
          <h2 class="projects-entry-title">
            <a
              class="projects-entry-link"
              href={withBase("/projects/" + getProjectSlug(p.title) + "/")}
            >
              {p.title}
            </a>
          </h2>
          <p>{p.summary}</p>
          <div class="tags">
            {p.stack.map((t) => (
              <span>{t}</span>
            ))}
          </div>
          <div class="project-links">
            <a href={withBase("/projects/" + getProjectSlug(p.title) + "/")}>
              Explorar proyecto <Icon name="arrow" size={17} />
            </a>
            {p.githubUrl && (
              <a href={p.githubUrl}>
                <Icon name="github" size={18} />
                GitHub <Icon name="arrow" size={17} />
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
    <RepoGrid caseStudies={caseStudies} />
  </main>
</BaseLayout>
