---
import Icon from "../../components/ui/Icon.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/ui/Navbar.astro";
import { siteConfig } from "../../lib/site";
import { getProjectSlug } from "../../lib/project-presentation";
import { getProjectCaseStudy } from "../../lib/project-case-studies";
import { withBase } from "../../lib/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { id: getProjectSlug(entry.data.title) },
    props: { project: entry.data },
  }));
}

const { project } = Astro.props;

const outboundUrl = project.liveUrl ?? project.githubUrl;
const caseStudy = getProjectCaseStudy(project.id);
const projectImage =
  project.coverImage ?? "/images/projects/fiscal-workspace.jpg";

const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.summary,
  url: new URL(
    Astro.url.pathname,
    Astro.site ?? "https://dreamcoder08.github.io",
  ).toString(),
  image: projectImage,
  creator: {
    "@type": "Person",
    name: "Dreamcoder",
    url: "https://github.com/dreamcoder08",
  },
  keywords: [project.domain, ...project.stack],
};
---

<BaseLayout
  title={`${project.title} — Proyecto`}
  description={project.summary}
  image={projectImage}
  jsonLd={projectJsonLd}
  lang="es"
>
  <Navbar />

  <main id="main-content" class="pt-24 pb-32">
    <!-- Header -->
    <section class="section-padding px-6">
      <div class="container-wide">
        <a
          href={withBase("/#projects")}
          class="inline-flex items-center gap-2 text-sm text-text-secondary hover:underline underline-offset-4 mb-8"
        >
          <Icon name="back" size={18} />
          Volver a los proyectos
        </a>

        <div class="flex items-center gap-3 mb-4">
          <span class="tag">{project.domain}</span>
          <span class="text-sm text-text-secondary">
            Actualizado en {project.updatedYear}
          </span>
        </div>

        <h1 class="text-4xl md:text-6xl font-bold mb-6">{project.title}</h1>
        <p class="text-lg text-text-secondary max-w-2xl leading-relaxed">
          {project.summary}
        </p>

        <div class="flex flex-wrap gap-2 mt-6">
          {project.stack?.map((tech) => (
            <span class="tag">{tech}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Cover Image -->
    {project.coverImage && (
      <section class="px-6 mb-16">
        <div class="container-wide">
          <div class="aspect-video rounded-panel overflow-hidden bg-surface-elevated border border-border">
            <img
              src={withBase(project.coverImage)}
              alt={project.coverImageAlt || project.title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </section>
    )}

    <!-- Content -->
    <section class="px-6">
      <div class="container-wide">
        {caseStudy ? (
          <div class="max-w-3xl space-y-10">
            <div class="card">
              <p class="section-label">Problema</p>
              <p class="text-lg leading-relaxed">{caseStudy.challenge}</p>
            </div>
            <div class="card">
              <p class="section-label">Enfoque</p>
              <p class="text-lg leading-relaxed">{caseStudy.approach}</p>
            </div>
            <div class="card">
              <p class="section-label">Estado</p>
              <p class="text-xl font-bold text-accent">{caseStudy.outcome}</p>
            </div>
            {caseStudy.evidence && (
              <div class="space-y-3">
                <p class="section-label">Referencias del proyecto</p>
                {caseStudy.evidence.map((item) => (
                  <div class="card flex items-start gap-3">
                    <span class="text-accent mt-1">▹</span>
                    <p class="text-text-secondary">{item}</p>
                  </div>
                ))}
              </div>
            )}
            {caseStudy.metrics && (
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                {caseStudy.metrics.map((m) => (
                  <div class="card text-center">
                    <p class="stat-number">{m.value}</p>
                    <p class="stat-label">{m.label}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        ) : (
          <p class="text-text-secondary italic">
            Consulta el repositorio para explorar el código, la documentación y
            el estado del proyecto.
          </p>
        )}

        <div class="mt-12">
          {outboundUrl ? (
            <a
              href={outboundUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              {project.liveUrl ? "Conocer el proyecto" : "Ver en GitHub"}
              <Icon name="arrow" size={18} />
            </a>
          ) : (
            /* Some projects deliberately have no public link. They still need a
               way forward, so they point at the contact section, which is what
               the rest of the site does when it cannot link to the product. */
            <a href={withBase("/#connect")} class="btn-primary">
              Hablar de este proyecto
              <Icon name="arrow" size={18} />
            </a>
          )}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
