---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/ui/Navbar.astro";
import { siteConfig, withBase } from "../lib/site";
import "../styles/portfolio.css";
import Icon from "../components/ui/Icon.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import ArchitectureSection from "../components/sections/ArchitectureSection.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import ProcessSection from "../components/sections/ProcessSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  lang="es"
>
  <Navbar />

  <main id="main-content" class="portfolio">
    <div class="scroll-rail" aria-hidden="true">
      <div class="scroll-rail-fill"></div>
      <div class="scroll-rail-readout"></div>
    </div>
    <HeroSection />
    <ProjectsSection />
    <AboutSection />
    <ArchitectureSection />
    <ServicesSection />
    <ProcessSection />
    <ContactSection />
  </main>

  <footer class="site-footer wrap">
    <a href={withBase("/")}>
      <Icon name="mark" size={24} /> <strong>dreamcoder</strong>
    </a>
    <p>© {new Date().getFullYear()} Dreamcoder</p>
    <a href="#main-content">
      Volver arriba <Icon name="up" size={16} />
    </a>
  </footer>
</BaseLayout>
