---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import type { IconName } from "../lib/icons";
import { siteConfig, withBase, mailto } from "../lib/site";
import "../styles/links.css";

type LinkKind = "work" | "build" | "social";
type LinkItem = {
  id: string;
  title: string;
  description: string;
  label: string;
  icon: IconName;
  href: string;
  kinds: LinkKind[];
  featured?: boolean;
  external?: boolean;
};

const links: LinkItem[] = [
  {
    id: "contact", title: "Let's work together", description: "Roles remotos, consultoría y colaboraciones.",
    label: "CONTACTO DIRECTO", icon: "mail", href: mailto("Let's work together — DreamCoder"),
    kinds: ["work"], featured: true,
  },
  {
    id: "portfolio", title: "DreamFolio", description: "Proyectos, decisiones técnicas y resultados verificables.",
    label: "PORTAFOLIO", icon: "globe", href: withBase("/"),
    kinds: ["work", "build"], featured: true,
  },
  {
    id: "github", title: "GitHub · Dreamcoder08", description: "Código abierto y evidencia de ingeniería.",
    label: "ENGINEERING", icon: "github", href: siteConfig.social.github,
    kinds: ["work", "build", "social"], external: true,
  },
  {
    id: "arkelythex", title: "ARKELYTHEX", description: "Laboratorio de ingeniería e inteligencia operativa.",
    label: "COMPANY", icon: "mark", href: "https://arkelythex.com/",
    kinds: ["build"], external: true,
  },
  {
    id: "drenyra", title: "Drenyra", description: "Sistemas financieros con IA, validación y control humano.",
    label: "FLAGSHIP PRODUCT", icon: "agents", href: "https://github.com/arkelythex/drenyra-command-center",
    kinds: ["build"], external: true,
  },
  {
    id: "mascli", title: "MASCLI", description: "Software aplicado a operaciones e investigación minera.",
    label: "SELECTED WORK", icon: "terminal", href: "https://github.com/Dreamcoder08/mascli",
    kinds: ["work", "build"], external: true,
  },
  {
    id: "x", title: "X / Twitter", description: "Ideas, ingeniería y avances de construcción.",
    label: "SOCIAL", icon: "x", href: siteConfig.social.x,
    kinds: ["social"], external: true,
  },
  {
    id: "instagram", title: "Instagram", description: "Mi lado creativo, visual y personal.",
    label: "SOCIAL", icon: "instagram", href: siteConfig.social.instagram,
    kinds: ["social"], external: true,
  },
];

const filters = [
  { id: "all", label: "Todos" },
  { id: "work", label: "Trabajo" },
  { id: "build", label: "Proyectos" },
  { id: "social", label: "Social" },
] as const;
---

<BaseLayout
  title="DreamCoder — Links · Work & Projects"
  description="Explora el trabajo, productos y canales oficiales de DreamCoder, arquitecto de software y fundador de ARKELYTHEX."
  image={siteConfig.profile.image}
  lang="es"
>
  <main id="main-content" class="links-page">
    <div class="links-shell">
      <header class="links-topbar">
        <a class="links-wordmark" href={withBase("/")} aria-label="Volver a DreamFolio">
          <Icon name="mark" size={19} />
          <span>dreamcoder<span class="wordmark-dot">.</span></span>
        </a>
        <span class="links-topnote">THE PERSONAL HUB <span aria-hidden="true">/</span> 001</span>
      </header>

      <section class="links-intro" aria-labelledby="links-name">
        <div class="links-portrait-frame">
          <img
            src={withBase(siteConfig.profile.image)}
            alt={siteConfig.profile.imageAlt}
            width="108"
            height="108"
            decoding="async"
          />
          <span class="links-orbit" aria-hidden="true">✳</span>
        </div>
        <p class="links-kicker">INDEPENDENT BUILDER <span aria-hidden="true">·</span> PERÚ → WORLDWIDE</p>
        <h1 id="links-name">Dream<span>Coder</span><span class="links-period">.</span></h1>
        <p class="links-role">Founder of ARKELYTHEX <span aria-hidden="true">/</span> AI Systems Product Engineer</p>
        <p class="links-description">
          I build systems that turn complex ideas into reliable software.
          Arquitectura, agentes de IA y productos con evidencia.
        </p>
        <a class="links-availability" href={mailto("Opportunity for DreamCoder")}>
          <span class="links-availability-pulse" aria-hidden="true"></span>
          Open to remote opportunities
          <Icon name="arrow" size={15} />
        </a>
      </section>

      <section class="links-index" aria-labelledby="links-section-title">
        <div class="links-section-head">
          <div>
            <p class="links-section-kicker">THE INDEX <span>01 — 08</span></p>
            <h2 id="links-section-title">Find your way in<span class="links-period">.</span></h2>
          </div>
          <span class="links-index-count" aria-label="8 enlaces disponibles">08 LINKS</span>
        </div>

        <div class="links-filters" role="group" aria-label="Filtrar enlaces" data-links-filters>
          {filters.map((filter) => (
            <button
              type="button"
              class="links-filter"
              data-filter={filter.id}
              aria-pressed={filter.id === "all" ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))}
        </div>

        <div class="links-grid" data-links-grid>
          {links.map((link, index) => (
            <a
              class:list={["links-card", { "links-card-featured": link.featured }]}
              href={link.href}
              data-link-kind={link.kinds.join(" ")}
              data-link-id={link.id}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              aria-label={link.title + ": " + link.description + (link.external ? " (abre en una nueva pestaña)" : "")}
            >
              <span class="links-card-leading">
                <span class="links-card-icon"><Icon name={link.icon} size={21} /></span>
                <span class="links-card-number">{String(index + 1).padStart(2, "0")}</span>
              </span>
              <span class="links-card-body">
                <span class="links-card-label">{link.label}</span>
                <span class="links-card-title">{link.title}</span>
                <span class="links-card-description">{link.description}</span>
              </span>
              <span class="links-card-arrow"><Icon name="arrow" size={20} /></span>
            </a>
          ))}
        </div>
        <p class="links-empty" data-links-empty hidden>No hay enlaces en esta categoría.</p>
      </section>

      <div class="links-sharebar">
        <div class="links-share-copy">
          <Icon name="mark" size={20} />
          <span>One identity. Multiple worlds.</span>
        </div>
        <div class="links-share-actions">
          <button type="button" data-links-copy aria-label="Copiar enlace de esta página">
            <Icon name="layers" size={16} /> Copiar link
          </button>
          <button type="button" data-links-share aria-label="Compartir esta página">
            <Icon name="arrow" size={16} /> Compartir
          </button>
        </div>
      </div>
      <p class="links-feedback" role="status" aria-live="polite" data-links-feedback></p>
      <footer class="links-footer">
        <span>© {new Date().getFullYear()} DREAMCODER</span>
        <a href={withBase("/")}>EXPLORE THE FULL PORTFOLIO <Icon name="arrow" size={15} /></a>
        <span>DESIGNED TO BUILD WHAT'S NEXT.</span>
      </footer>
    </div>
  </main>
</BaseLayout>

<script>
  import "../scripts/links.ts";
</script>
