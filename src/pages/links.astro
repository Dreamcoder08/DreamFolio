---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/ui/Navbar.astro";
import Icon from "../components/ui/Icon.astro";
import { withBase, withBaseAsset, mailto } from "../lib/site";
import "../styles/links.css";
import "../styles/links-cards.css";
import "../styles/links-mobile.css";

import { links, filters } from "../data/links";
---

<BaseLayout
  title="DreamCoder — Links · Work & Projects"
  description="Explora el trabajo, productos y canales oficiales de DreamCoder, arquitecto de software y fundador de ARKELYTHEX."
  lang="es"
>
  <Navbar />
  <main id="main-content" class="portfolio links-page">
    <div class="links-shell wrap">
      <section class="links-intro" aria-labelledby="links-name">
        <div class="links-intro-copy">
          <p class="eyebrow links-kicker">DREAMCODER / PERSONAL HUB</p>
          <h1 id="links-name">
            Un perfil.
            <br />
            <span>Mil conexiones.</span>
          </h1>
          <p class="links-role">
            DreamCoder · Arquitecto de software · Fundador de ARKELYTHEX
          </p>
          <p class="links-description">
            Diseño y construyo sistemas de software, productos y agentes de IA.
            Aquí puedes explorar mi trabajo o contactarme para colaborar.
          </p>
          <div class="links-intro-actions">
            <a
              class="solid-link"
              href={mailto("Oportunidad de colaboración — DreamCoder")}
            >
              Hablemos de tu proyecto <Icon name="arrow" size={17} />
            </a>
            <a class="quiet-link" href={withBase("/")}>
              Ver portafolio completo <Icon name="arrow" size={17} />
            </a>
          </div>
        </div>
        <figure class="links-portrait-frame">
          <div class="links-portrait-image">
            <img
              src={withBaseAsset("/images/dreamcoder-profile.avif")}
              alt="Retrato de Dreamcoder con chaqueta técnica y gafas"
              width="280"
              height="350"
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption>PERÚ · UTC−5 / BUILDING WORLDWIDE</figcaption>
        </figure>
      </section>

      <section class="links-index" aria-labelledby="links-section-title">
        <div class="links-section-head">
          <div>
            <p class="eyebrow links-section-kicker">ENLACES / 01 — 07</p>
            <h2 id="links-section-title">
              Explora <span>mis enlaces.</span>
            </h2>
          </div>
          <span class="links-index-count" aria-label="7 enlaces disponibles">
            07 ENLACES
          </span>
        </div>

        <div
          class="links-filters"
          role="group"
          aria-label="Filtrar enlaces"
          data-links-filters
        >
          {filters.map((filter) => (
            <button
              type="button"
              class="links-filter"
              data-filter={filter.id}
              aria-pressed={filter.id === "all" ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))}
        </div>

        <div class="links-grid" data-links-grid>
          {links.map((link, index) => (
            <a
              class:list={[
                "links-card",
                { "links-card-featured": link.featured },
              ]}
              href={link.href}
              data-link-kind={link.kinds.join(" ")}
              data-link-id={link.id}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              aria-label={
                link.title +
                ": " +
                link.description +
                (link.external ? " (abre en una nueva pestaña)" : "")
              }
            >
              <span class="links-card-leading">
                <span class="links-card-icon">
                  <Icon name={link.icon} size={21} />
                </span>
                <span class="links-card-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </span>
              <span class="links-card-body">
                <span class="links-card-label">{link.label}</span>
                <span class="links-card-title">{link.title}</span>
                <span class="links-card-description">{link.description}</span>
              </span>
              <span class="links-card-arrow">
                <Icon name="arrow" size={20} />
              </span>
            </a>
          ))}
        </div>
        <p class="links-empty" data-links-empty hidden>
          No hay enlaces en esta categoría.
        </p>
      </section>

      <div class="links-sharebar">
        <div class="links-share-copy">
          <Icon name="mark" size={20} />
          <span>One identity. Multiple worlds.</span>
        </div>
        <div class="links-share-actions">
          <button
            type="button"
            data-links-copy
            aria-label="Copiar enlace de esta página"
          >
            <Icon name="layers" size={16} /> Copiar link
          </button>
          <button
            type="button"
            data-links-share
            aria-label="Compartir esta página"
          >
            <Icon name="arrow" size={16} /> Compartir
          </button>
        </div>
      </div>
      <p
        class="links-feedback"
        role="status"
        aria-live="polite"
        data-links-feedback
      ></p>
      <footer class="links-footer">
        <span>© {new Date().getFullYear()} DREAMCODER</span>
        <a href={withBase("/")}>
          EXPLORE THE FULL PORTFOLIO <Icon name="arrow" size={15} />
        </a>
        <span>DESIGNED TO BUILD WHAT'S NEXT.</span>
      </footer>
    </div>
  </main>
</BaseLayout>

<script>
  import "../scripts/links.ts";
</script>
